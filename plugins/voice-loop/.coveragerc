# Coverage of the server is a hard gate at 100% (statements AND branches) — see TESTING.md (next to
# this file) for what that number does and does not claim. Read from this directory: the suite runs
# as `cd plugins/voice-loop && pytest …`, and `source` resolves through pytest.ini's `pythonpath`.
#
# scripts/ is also under coverage measurement, enforced via TWO separate CI gates so a regression
# in one scope cannot hide behind another's threshold:
#   • `coverage report --include='scripts/*' --fail-under=100` (100% of what is measurable on a
#     Linux runner; the exclusions are disclosed by class in TESTING.md, not silently inherited
#     from this file) for the hook scripts (dictate.py, speak.py, report_bug.py, tls-probe.py) —
#     proven in parallel by real invocation, so the gate exists to keep regression pressure on the
#     helper surface.
#   • `coverage report --include='scripts/doctor.py' --fail-under=100` for the diagnose tool the
#     user runs first when something is wrong, so it cannot be the broken thing they hit.
# The server's 100% is non-negotiable and never dropped. The combined coverage job downloads this
# per-plugin .coverage artifact and combines it with sill-core's artifact for the shelf-level
# report.
[run]
branch = True
source = voice_server, scripts

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    pragma: windows-only
    pragma: macos-only

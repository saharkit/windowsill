#!/usr/bin/env python3
"""Stable desktop entry point for voice-loop dictation.

Claude Code replaces versioned cache directories on plugin updates.  The desktop
cannot expand ``CLAUDE_PLUGIN_ROOT``, so this launcher asks Claude Code's own
installed-plugin registry for the current install path at every invocation.

Cross-platform: Linux/macOS use ``os.execv`` (the original behaviour — replaces
this process with the dict script so signal handling is shared); Windows uses
``subprocess.run`` because ``os.execv`` raises ``OSError`` there. The two arms
also resolve different launcher leaves — the ``.sh`` the POSIX desktop binds,
and the ``.cmd`` shim CreateProcess can actually run (a ``.sh`` under
CreateProcess is WinError 193, so a single hardcoded leaf fails one platform
outright).
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

_PLUGIN_KEY = "voice-loop@windowsill"
# Capture the host path class before tests (and callers) can patch os.name to select a branch.  The
# pathlib.Path factory consults os.name on every construction, so a patched Windows runner would
# otherwise try to instantiate PosixPath and fail before the launcher reaches its seam.
_OS_PATH = type(Path())


def _script_leaf(platform: str | None = None) -> str:
    """The launcher leaf for a platform: the ``.cmd`` shim on Windows, the ``.sh`` elsewhere.

    ``subprocess.run`` reaches the child through CreateProcess, which does NOT consult shell file
    associations — a ``.sh`` there is WinError 193 ("not a valid Win32 application") before bash is
    ever asked, so every durable hotkey invocation on Windows would fail. The leaf is chosen per
    call (a parameter, not a module constant) so ``_current_script`` can be driven for either
    platform without patching the process-global ``os.name``.  Resolve the default at call time:
    tests and embedders may temporarily select a platform after this module was imported."""
    if platform is None:
        platform = os.name
    return "scripts/dictate-toggle.cmd" if platform == "nt" else "scripts/dictate-toggle.sh"


def _config_dir() -> Path:
    return _OS_PATH(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")).expanduser()


def _registry_paths() -> tuple[Path, ...]:
    """Return registry locations in precedence order."""
    return (_config_dir() / "plugins" / "installed_plugins.json",)


def _entries(raw: Any) -> list[dict[str, Any]]:
    plugins = raw.get("plugins", {}) if isinstance(raw, dict) else {}
    value = plugins.get(_PLUGIN_KEY, []) if isinstance(plugins, dict) else []
    if isinstance(value, dict):
        value = [value]
    return [entry for entry in value if isinstance(entry, dict)] if isinstance(value, list) else []


def _current_script(platform: str | None = None) -> Path | None:
    """Find the current plugin script from Claude Code's install registry.

    An ambiguous or malformed registry is a refusal, not an invitation to guess
    by sorting cache directory names. Claude Code refreshes this registry when
    the plugin is updated, which is the indirection the desktop binding needs.

    ``platform`` selects the launcher leaf (see _script_leaf): the .cmd shim on
    Windows, the .sh everywhere else. CreateProcess cannot run a .sh, so the
    POSIX leaf would fail every Windows invocation outright (WinError 193).
    """
    leaf = _script_leaf(platform)
    for registry in _registry_paths():
        try:
            raw = json.loads(registry.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        candidates: list[tuple[Path, dict[str, Any]]] = []
        for entry in _entries(raw):
            install_path = entry.get("installPath")
            if not isinstance(install_path, str) or not install_path:
                continue
            script = _OS_PATH(install_path).expanduser() / leaf
            if script.is_file():
                candidates.append((script, entry))
        user_candidates = [script for script, entry in candidates if entry.get("scope") == "user"]
        if len(user_candidates) == 1:
            return user_candidates[0]
        if len(user_candidates) > 1 or len(candidates) > 1:
            return None
        if candidates:
            return candidates[0][0]
    return None


def main() -> int:
    script = _current_script()
    if script is None:
        print(
            "voice-loop-dictate: cannot identify exactly one current voice-loop install — "
            "the registry is missing, empty, or ambiguous",
            file=sys.stderr,
        )
        return 1
    argv = [str(script), *sys.argv[1:]]
    if os.name == "nt":
        # Windows: os.execv is not implemented, so chain through subprocess and propagate the
        # child's exit code. The child is the same Python that would have been exec'd on POSIX,
        # so the only behavioural difference is the parent waiting on the child rather than
        # being replaced by it — irrelevant for a launcher.
        try:
            result = subprocess.run(argv, check=False)
        except OSError as err:
            print(
                f"voice-loop-dictate: spawn failed: {err}",
                file=sys.stderr,
            )
            return 1
        return result.returncode
    try:
        os.execv(str(script), argv)
    except OSError as err:
        print(
            f"voice-loop-dictate: exec failed: {err}",
            file=sys.stderr,
        )
        return 1
    return 1  # unreachable — execv replaces the process on success


if __name__ == "__main__":
    raise SystemExit(main())

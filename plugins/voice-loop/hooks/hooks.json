{
  "description": "voice-loop: speak the assistant's marker-tagged lines when a turn ends — and, with speak.eager on, as soon as they appear mid-turn",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/speak.py\"",
            "async": true,
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/speak.py\"",
            "async": true,
            "timeout": 90
          }
        ]
      }
    ]
  }
}

{
  "description": "voice-loop: speak the assistant's marker-tagged lines when a turn ends",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/speak.sh\"",
            "async": true,
            "timeout": 90
          }
        ]
      }
    ]
  }
}

# Coverage of the server is a hard gate at 100% (statements AND branches) — see TESTING.md (next to
# this file) for what that number does and does not claim. Read from this directory: the suite runs
# as `cd plugins/voice-loop && pytest …`, and `source` resolves through pytest.ini's `pythonpath`.
#
# scripts/ is also under coverage measurement. The 100% claim for `scripts/*`, `scripts/doctor.py`
# and `scripts/speak.py` was moved off this file's per-leg gate and onto the union after #276:
# platform-specific code is now MEASURED on a coverage leg per platform (Linux, Windows, macOS)
# rather than excluded. This file's `exclude_lines` therefore carries only `pragma: no cover` —
# the one non-platform marker left in the plugin (server/voice_server.py:2245's `__main__` shell,
# declared in TESTING.md). The `pragma: windows-only` and `pragma: macos-only` tokens that used
# to live here are gone; the markers themselves stay in the source as documentation of what
# each platform leg is responsible for exercising.
#
# The server's 100% is non-negotiable and never dropped, and is asserted on every leg (Linux,
# Windows, macOS). The combined coverage job downloads this per-plugin .coverage artifact and
# combines it with sill-core's artifact for the shelf-level report; the three union gates for
# `scripts/*`, `scripts/doctor.py` and `scripts/speak.py` run there against the combined data.
[run]
branch = True
source = voice_server, scripts

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover

# Coverage of the server is a hard gate at 100% (statements AND branches) — see TESTING.md (next to
# the plugin in plugins/voice-loop/) for what that number does and does not claim. Read from this
# directory: the suite runs as `cd tests/voice-loop && pytest …`, and `source` resolves through
# pytest.ini's `pythonpath`. The plugin folder is the install target and ships every file in it,
# so this test root lives in `tests/voice-loop/` rather than inside the plugin — see CLAUDE.md.
#
# scripts/ is also under coverage measurement. The 100% claim for `scripts/*`, `scripts/doctor.py`
# and `scripts/speak.py` was moved off this file's per-leg gate and onto the union after #276:
# platform-specific code is now MEASURED on a coverage leg per platform (Linux, Windows, macOS)
# rather than excluded. This file's `exclude_lines` therefore carries only `pragma: no cover` —
# the one non-platform marker left in the plugin (server/voice_server.py:2245's `__main__` shell,
# declared in TESTING.md). The `pragma: windows-only` and `pragma: macos-only` tokens that used
# to live here are gone; the markers themselves stay in the source as documentation of what
# each platform leg is responsible for exercising.
#
# The server's 100% is non-negotiable and never dropped. It is asserted on the four Linux
# matrix legs (Python 3.10–3.13) — those run `coverage report --include='**/plugins/voice-loop/
# server/voice_server*' --fail-under=100` after pytest. The Windows and macOS legs collect
# coverage for the union gate but do NOT re-assert the server 100%, because the per-leg data
# would be the same statements measured against a second Python on the same code (the gate
# already fires on every matrix leg). The combined coverage job downloads this per-plugin
# .coverage artifact and combines it with sill-core's artifact for the shelf-level report;
# the three union gates for `scripts/*`, `scripts/doctor.py` and `scripts/speak.py` run there
# against the combined data.
[run]
branch = True
source = voice_server, ../../plugins/voice-loop/scripts

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
